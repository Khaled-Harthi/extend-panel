    "url": "git+https://github.com/Khaled-Harthi/extend-panel.git"
  },
  "bugs": {
    "url": "https://github.com/Khaled-Harthi/extend-panel/issues"
  },
  "homepage": "https://github.com/Khaled-Harthi/extend-panel#readme",
  "files": [
